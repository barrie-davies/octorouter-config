# CLIProxyAPI
CLIPROXYAPI_IMAGE=eceasy/cli-proxy-api-plus:latest
CLIPROXYAPI_PORT=8317
CLIPROXYAPI_AUTH_DIR=./auths
CLIPROXYAPI_DEPLOY=cloud

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME

# Dashboard
DASHBOARD_PORT=3000
JWT_SECRET=CHANGE_ME
MANAGEMENT_API_KEY=CHANGE_ME

# Dashboard redeploy webhook (adnanh/webhook on host, reachable via docker host-gateway)
DEPLOY_SECRET=CHANGE_ME
WEBHOOK_HOST=http://host.docker.internal:9000
