[Unit]
Description=OctoRouter Dashboard Deploy Webhook
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/opt/octorouter/.env
ExecStart=/usr/local/bin/webhook -hooks /opt/octorouter/webhook/webhook.yaml -ip 0.0.0.0 -port 9000 -verbose
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
